# Copie este archivo como .env antes de levantar el despliegue. El archivo .env NO se sube al repositorio.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
# Los valores de abajo son marcadores de un laboratorio local; no son secretos reales.
# Para un uso real cambie DB_PASSWORD por una clave propia.

# --- Base de datos (los usan db y las tres replicas) ---
DB_USER=envios_user
DB_PASSWORD=clave_local_de_laboratorio
DB_NAME=envios_db

# --- Imagen publicada en Docker Hub: <DOCKERHUB_USER>/envios-app:<APP_VERSION> ---
# Usuario de Docker Hub que publica la imagen (no es un secreto).
DOCKERHUB_USER=angelaguilarcontre
APP_VERSION=1.0.0

# --- Prueba de timeout ---
# false = servicio normal (valor por defecto). true = habilita la cabecera X-Test-Delay-Ms
# para simular una respuesta lenta. Dejar en false fuera de la prueba.
ENABLE_TEST_DELAY=false
